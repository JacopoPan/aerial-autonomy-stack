GZBridge.cpp: add the error model in gnss_contested.h to navSatCallback(), which turns Gazebo's NavSat sensor into PX4's GPS
Includes "gnss_contested.h" (copied in by simulation.dockerfile): the same GNSS noise model for PX4, ArduPilot, and Betaflight SITL

diff --git a/src/modules/simulation/gz_bridge/GZBridge.cpp b/src/modules/simulation/gz_bridge/GZBridge.cpp
index 3ef65e1..698bd5d 100644
--- a/src/modules/simulation/gz_bridge/GZBridge.cpp
+++ b/src/modules/simulation/gz_bridge/GZBridge.cpp
@@ -43,6 +43,10 @@
 #include <iostream>
 #include <string>
 
+#include "gnss_contested.h" // AAS: contested GNSS model, copied here by simulation.dockerfile
+
+static aas_gnss_t aas_gnss{}; // AAS: contested GNSS state
+
 GZBridge::GZBridge(const std::string &world, const std::string &model_name) :
 	ModuleParams(nullptr),
 	ScheduledWorkItem(MODULE_NAME, px4::wq_configurations::rate_ctrl),
@@ -741,6 +745,19 @@ void GZBridge::navSatCallback(const gz::msgs::NavSat &msg)
 	// Apply noise model (based on ublox F9P)
 	addGpsNoise(latitude, longitude, altitude, vel_north, vel_east, vel_down);
 
+	// AAS: contested GNSS (gnss_contested.h): its errors, satellites (no fix below 4), and accuracies, nominal otherwise
+	aas_gnss_update(&aas_gnss, timestamp * 1e-6);
+	const int satellites = (aas_gnss.satellites >= 0) ? aas_gnss.satellites : _sim_gps_used.get();
+
+	if (aas_gnss.satellites >= 0) {
+		add_vector_to_global_position(latitude, longitude, static_cast<float>(aas_gnss.error_ned_m[0]), static_cast<float>(aas_gnss.error_ned_m[1]),
+					      &latitude, &longitude);
+		altitude -= aas_gnss.error_ned_m[2];
+		vel_north += static_cast<float>(aas_gnss.velocity_error_ned_m_s[0]);
+		vel_east += static_cast<float>(aas_gnss.velocity_error_ned_m_s[1]);
+		vel_down += static_cast<float>(aas_gnss.velocity_error_ned_m_s[2]);
+	}
+
 	// Device ID
 	device::Device::DeviceId id{};
 	id.devid_s.bus_type = device::Device::DeviceBusType::DeviceBusType_SIMULATION;
@@ -750,7 +767,7 @@ void GZBridge::navSatCallback(const gz::msgs::NavSat &msg)
 
 	sensor_gps_s sensor_gps{};
 
-	if (_sim_gps_used.get() >= 4) {
+	if (satellites >= 4) {
 		// fix
 		sensor_gps.fix_type = 3; // 3D fix
 		sensor_gps.s_variance_m_s = 0.4f;
@@ -760,6 +777,14 @@ void GZBridge::navSatCallback(const gz::msgs::NavSat &msg)
 		sensor_gps.hdop = 0.7f;
 		sensor_gps.vdop = 1.1f;
 
+		if (aas_gnss.eph_m > 0.0) { // AAS: contested
+			sensor_gps.s_variance_m_s = static_cast<float>(aas_gnss.sacc_m_s);
+			sensor_gps.eph = static_cast<float>(aas_gnss.eph_m);
+			sensor_gps.epv = static_cast<float>(aas_gnss.epv_m);
+			sensor_gps.hdop = static_cast<float>(aas_gnss.hdop);
+			sensor_gps.vdop = static_cast<float>(aas_gnss.vdop);
+		}
+
 	} else {
 		// no fix
 		sensor_gps.fix_type = 0; // No fix
@@ -794,7 +819,7 @@ void GZBridge::navSatCallback(const gz::msgs::NavSat &msg)
 	sensor_gps.jamming_state = 0;
 	sensor_gps.spoofing_state = 0;
 	sensor_gps.vel_ned_valid = true;
-	sensor_gps.satellites_used = _sim_gps_used.get();
+	sensor_gps.satellites_used = satellites;
 
 	_sensor_gps_pub.publish(sensor_gps);
 }
