SIM_GPS.cpp: add the error model in gnss_contested.h to the first simulated GPS's update() method
SIM_GPS.h: add HDOP and VDOP to GPS_Data, 0 unless contested
SIM_GPS_UBLOX.cpp: send GPS_Data's HDOP and VDOP if set (else the fixed 1.21 and 2.0 of stock SITL)
SIM_GPS_UBLOX.cpp: (bugfix) report the speed accuracy in mm/s, as ArduPilot reads it (as it was, in cm/s, it was 10 times too good and the EKF over-trusted a degraded GPS velocity)
Includes "gnss_contested.h" (copied in by simulation.dockerfile): the same GNSS noise model for PX4, ArduPilot, and Betaflight SITL

diff --git a/libraries/SITL/SIM_GPS.cpp b/libraries/SITL/SIM_GPS.cpp
index d51521c..1fe8828 100644
--- a/libraries/SITL/SIM_GPS.cpp
+++ b/libraries/SITL/SIM_GPS.cpp
@@ -30,6 +30,10 @@
 
 #include <GCS_MAVLink/GCS.h>
 
+#include "gnss_contested.h" // AAS: contested GNSS model, copied here by simulation.dockerfile
+
+static aas_gnss_t aas_gnss {}; // AAS: contested GNSS state, for the first GPS
+
 // the number of GPS leap seconds - copied from AP_GPS.h
 #define GPS_LEAPSECONDS_MILLIS 18000ULL
 
@@ -431,6 +435,31 @@ void GPS::update()
             simulate_jamming(d);
         }
 
+    // AAS: contested GNSS (gnss_contested.h) for the first GPS: its errors, satellites (no fix below 4), and accuracies, nominal otherwise
+    if (instance == 0) {
+        aas_gnss_update(&aas_gnss, now_ms * 1e-3);
+        if (aas_gnss.satellites >= 0) {
+            int32_t lat = int32_t(d.latitude * 1e7);
+            int32_t lng = int32_t(d.longitude * 1e7);
+            Location::offset_latlng(lat, lng, aas_gnss.error_ned_m[0], aas_gnss.error_ned_m[1]);
+            d.latitude = lat * 1e-7;
+            d.longitude = lng * 1e-7;
+            d.altitude -= float(aas_gnss.error_ned_m[2]);
+            d.speedN += aas_gnss.velocity_error_ned_m_s[0];
+            d.speedE += aas_gnss.velocity_error_ned_m_s[1];
+            d.speedD += aas_gnss.velocity_error_ned_m_s[2];
+            d.num_sats = uint8_t(aas_gnss.satellites);
+            d.have_lock = d.have_lock && aas_gnss.satellites >= AAS_GNSS_MIN_FIX_SATELLITES;
+        }
+        if (aas_gnss.eph_m > 0.0) {
+            d.horizontal_acc = float(aas_gnss.eph_m);
+            d.vertical_acc = float(aas_gnss.epv_m);
+            d.speed_acc = float(aas_gnss.sacc_m_s);
+            d.hdop = float(aas_gnss.hdop);
+            d.vdop = float(aas_gnss.vdop);
+        }
+    }
+
     backend->publish(&d);
 }
 
