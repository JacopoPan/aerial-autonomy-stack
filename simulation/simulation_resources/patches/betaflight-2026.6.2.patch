+// AAS: errors of a real receiver for the virtual GPS (0 for a perfect one): 10 Hz fixes, each published one period after
+// its measurement, with a slowly wandering position error (first-order Gauss-Markov) and white noise
+#define SITL_GPS_PERIOD_S       0.1     // gps_update_rate_hz = 10, also the fix delay
+#define SITL_GPS_WANDER_M       1.0     // Standard deviation of the slow position error, per ENU axis
+#define SITL_GPS_WANDER_TAU_S   60.0    // Correlation time of the slow position error
+#define SITL_GPS_NOISE_M        0.2     // White position noise, per ENU axis
+#define SITL_GPS_VEL_NOISE_MS   0.05    // White velocity noise, per ENU axis
+
+static double sitlGpsNoise(double sigma) // Normal sample (Box-Muller), the same sequence in every run
+{
+    const double u1 = (rand() + 1.0) / (RAND_MAX + 2.0);
+    const double u2 = rand() / (RAND_MAX + 1.0);
+    return sigma * sqrt(-2.0 * log(u1)) * cos(2.0 * M_PI * u2);
+}
