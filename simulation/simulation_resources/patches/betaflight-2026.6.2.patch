diff --git a/src/platform/SIMULATOR/sitl_gyro.h b/src/platform/SIMULATOR/sitl_gyro.h
index 4232e57..8409631 100644
--- a/src/platform/SIMULATOR/sitl_gyro.h
+++ b/src/platform/SIMULATOR/sitl_gyro.h
@@ -30,7 +30,7 @@
 // frame effectively FRD (X=fwd, Y=right, Z=down):
 //   Roll  = +wx_FRD (roll right)                               -> keep X
 //   Pitch = -wy_FRD (BF positive = nose down, opposite to FRD) -> negate Y
-//   Yaw   = +wz_FRD (CW viewed from above)                     -> keep Z
-// Legacy bridges (X-Plane, RealFlight) deliver yaw with the opposite polarity
-// and therefore require Z to be negated.
+//   Yaw   = -wz_FRD (BF positive = counter-clockwise, as FLU) -> negate Z (AAS)
+// Legacy bridges (X-Plane, RealFlight) also require Z to be negated, so
+// gazeboBridge no longer changes the mapping (AAS).
 //
@@ -44,5 +44,6 @@ static inline void sitlGyroBodyFromSim(const double rpy[3], bool gazeboBridge,
 {
     *roll  =  rpy[0];
     *pitch = -rpy[1];
-    *yaw   =  gazeboBridge ? rpy[2] : -rpy[2];
+    (void)gazeboBridge; // AAS: Gazebo also needs Z negated, or a clockwise turn turns Betaflight's heading counter-clockwise
+    *yaw   = -rpy[2];
 }
