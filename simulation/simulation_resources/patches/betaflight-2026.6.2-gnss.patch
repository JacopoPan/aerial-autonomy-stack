diff --git a/src/platform/SIMULATOR/sitl.c b/src/platform/SIMULATOR/sitl.c
index 4e5c209..ebc4696 100644
--- a/src/platform/SIMULATOR/sitl.c
+++ b/src/platform/SIMULATOR/sitl.c
@@ -77,6 +77,7 @@
 
 #include "io/gps.h"
 #include "io/gps_virtual.h"
+#include "gnss_contested.h" // AAS: contested GNSS model, copied here by simulation.dockerfile
 
 #include "dyad.h"
 #include "udplink.h"
@@ -288,6 +289,8 @@ static void sendMotorUpdate(void)
 #define SITL_GPS_NOISE_M        0.2     // White position noise, per ENU axis
 #define SITL_GPS_VEL_NOISE_MS   0.05    // White velocity noise, per ENU axis
 
+static aas_gnss_t aasGnss; // AAS: contested GNSS state
+
 static double sitlGpsNoise(double sigma) // Normal sample (Box-Muller), the same sequence in every run
 {
     const double u1 = (rand() + 1.0) / (RAND_MAX + 2.0);
@@ -483,6 +486,17 @@ static void updateState(const fdm_packet* pkt)
             error[i] = wander[i] + sitlGpsNoise(SITL_GPS_NOISE_M);
             fix[3 + i] += sitlGpsNoise(SITL_GPS_VEL_NOISE_MS);
         }
+        // AAS: contested GNSS (gnss_contested.h): its errors (here ENU), satellites (no fix below 4), and accuracies, nominal otherwise
+        aas_gnss_update(&aasGnss, pkt->timestamp);
+        if (aasGnss.satellites >= 0) {
+            error[0] += aasGnss.error_ned_m[1];
+            error[1] += aasGnss.error_ned_m[0];
+            error[2] -= aasGnss.error_ned_m[2];
+            fix[3] += aasGnss.velocity_error_ned_m_s[1];
+            fix[4] += aasGnss.velocity_error_ned_m_s[0];
+            fix[5] -= aasGnss.velocity_error_ned_m_s[2];
+        }
+        setVirtualGPSQuality(aasGnss.satellites, aasGnss.eph_m, aasGnss.epv_m, aasGnss.sacc_m_s, aasGnss.hdop, aasGnss.vdop);
         fix[0] += error[1] / 111319.5; // North, in degrees of latitude
         fix[1] += error[0] / (111319.5 * cos(fix[0] * M_PI / 180.0)); // East
         fix[2] += error[2];
