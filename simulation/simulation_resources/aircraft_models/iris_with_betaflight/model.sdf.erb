      <%
        # Compute the gimbal pose based on the desired camera pose
        cam_pose = camera_ext.split(' ').map(&:to_f)
        gimbal_x = cam_pose[0] - 0.04 # Pull the gimbal base back by 4cm, see gimbal dimensions in sensor_gimbal/model.sdf
        gimbal_z = cam_pose[2] + 0.04 # Pull the gimbal base up by 4cm, see gimbal dimensions in sensor_gimbal/model.sdf
        gimbal_ext = "#{gimbal_x} #{cam_pose[1]} #{gimbal_z} #{cam_pose[3]} #{cam_pose[4]} #{cam_pose[5]}"
      %>
      <include merge="true">
        <uri>model://sensor_gimbal</uri>
        <pose degrees="true"><%= gimbal_ext %></pose>
      </include>
      <joint name="GimbalJoint" type="fixed">
        <parent>base_link</parent>
        <child>gimbal/base_link</child>
      </joint>
      <include>
        <uri>model://sensor_camera</uri>
        <name>simple_camera</name>
        <pose relative_to="pitch_link">0 0 0 0 0 0</pose>
      </include>
      <joint name="CameraJoint" type="fixed">
        <parent>pitch_link</parent>
        <child>simple_camera::mono_cam/base_link</child>
      </joint>
      <!-- Alternatively, use fixed camera
      <include>
        <uri>model://sensor_camera</uri>
        <name>simple_camera</name>
        <pose degrees="true"><%= camera_ext %></pose>
      </include>
      <joint name="CameraJoint" type="fixed">
        <parent>base_link</parent>
        <child>simple_camera::mono_cam/base_link</child>
      </joint>
      -->

      <include>
        <uri>model://sensor_lidar</uri>
        <name>simple_lidar</name>
        <pose degrees="true"><%= lidar_ext %></pose>
      </include>
      <joint name="LidarJoint" type="fixed">
        <parent>base_link</parent>
        <child>simple_lidar::lidar/base_link</child>
      </joint>

