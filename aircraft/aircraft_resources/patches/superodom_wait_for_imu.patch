index a6dd44d..d636a01 100755
--- a/super_odometry/src/FeatureExtraction/featureExtraction.cpp
+++ b/super_odometry/src/FeatureExtraction/featureExtraction.cpp
@@ -814,7 +814,7 @@ namespace super_odometry {
 
         manageLidarBuffer(pointCloud, msg->header.stamp.sec + msg->header.stamp.nanosec*1e-9);
 
